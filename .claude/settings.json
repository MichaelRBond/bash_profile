  "model": "fable",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/zellij-tab.sh start"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/zellij-tab.sh stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/status-lines/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(aws secretsmanager get-secret-value:*) in any repo — CLAUDE.md explicitly forbids reading secret values into context",
      "Bash(aws:*) mutating/destructive subcommands (create-*, delete-*, update-*, put-*, terminate-*) — CLAUDE.md forbids mutating or destructive AWS calls via CLI",
      "Bash(aws athena start-query-execution:*) where the query is not read-only: CREATE, CREATE TABLE AS, INSERT INTO, DROP, ALTER, MSCK REPAIR, UNLOAD"
    ]
  }
}
